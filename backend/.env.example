DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,bazikhooneh.codelighthouse.ir
DJANGO_CSRF_TRUSTED_ORIGINS=https://bazikhooneh.codelighthouse.ir
TURN_HOST=bazikhooneh.codelighthouse.ir

# Firebase Cloud Messaging (absolute path on the host; never commit the file)
FIREBASE_CREDENTIALS_PATH=/run/secrets/bazikhooneh-firebase-admin.json
FIREBASE_PROJECT_ID=bazikhooneh-cfcba

# Transactional email (production can use the self-hosted SMTP service)
EMAIL_DELIVERY_ENABLED=false
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.bazikhooneh.codelighthouse.ir
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@bazikhooneh.codelighthouse.ir
EMAIL_HOST_PASSWORD=replace-with-an-app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=BaziKhooneh <no-reply@bazikhooneh.codelighthouse.ir>

# Production examples:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=bazikhooneh
# DB_USER=bazikhooneh
# DB_PASSWORD=replace-me
# DB_HOST=127.0.0.1
# DB_PORT=5432
