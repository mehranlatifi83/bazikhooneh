    <string name="ludo_guide_title">قوانین و راهنمای منچ</string><string name="ludo_mode_description">بازی نوبتی روی همین گوشی، بازی با سه ربات یا بازی آنلاین تا چهار بازیکن را انتخاب کنید.</string>
