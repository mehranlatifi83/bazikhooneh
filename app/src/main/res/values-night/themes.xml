<resources>
    <style name="Theme.BaziKhooneh" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Widget.BaziKhooneh.BoardCell" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">92dp</item>
        <item name="android:layout_height">92dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/board_cell_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
