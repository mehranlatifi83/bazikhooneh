<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:background="@color/screen_background">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/security_hub_description" android:textSize="18sp" />
 <Button android:id="@+id/open_username_change" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:minHeight="60dp" android:text="@string/change_username_title" android:textAllCaps="false" />
 <Button android:id="@+id/open_email_verification" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="60dp" android:text="@string/email_security_title" android:textAllCaps="false" />
 <Button android:id="@+id/open_password_change" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="60dp" android:text="@string/change_password_title" android:textAllCaps="false" />
 <Button android:id="@+id/open_sessions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="60dp" android:text="@string/sessions_title" android:textAllCaps="false" />
</LinearLayout>
