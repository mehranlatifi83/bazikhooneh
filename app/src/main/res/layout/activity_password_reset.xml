<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/screen_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/password_reset_description" android:textSize="18sp" />
  <EditText android:id="@+id/reset_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="@string/email_address" android:inputType="textEmailAddress" />
  <Button android:id="@+id/request_reset" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/send_reset_code" android:textAllCaps="false" />
  <EditText android:id="@+id/reset_code" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/verification_code" />
  <EditText android:id="@+id/reset_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/new_password" android:inputType="textPassword" />
  <Button android:id="@+id/confirm_reset" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reset_password" android:textAllCaps="false" />
  <TextView android:id="@+id/reset_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
 </LinearLayout>
</ScrollView>
