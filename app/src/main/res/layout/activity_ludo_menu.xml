<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/screen_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ludo_mode_description" android:textSize="18sp" />
  <Button android:id="@+id/ludo_local" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/ludo_local_mode" />
  <LinearLayout android:id="@+id/ludo_local_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ludo_player_count" />
   <RadioGroup android:id="@+id/ludo_player_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <RadioButton android:id="@+id/ludo_two_players" android:layout_width="wrap_content" android:layout_height="48dp" android:checked="true" android:text="@string/two_players" />
    <RadioButton android:id="@+id/ludo_three_players" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/three_players" />
    <RadioButton android:id="@+id/ludo_four_players" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/four_players" />
   </RadioGroup>
   <Button android:id="@+id/ludo_start_local" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/start_game" android:visibility="gone" />
  </LinearLayout>
  <Button android:id="@+id/ludo_bots" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ludo_bot_mode" />
  <Button android:id="@+id/ludo_online" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ludo_online_mode" />
  <Button android:id="@+id/ludo_guide" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/ludo_guide_title" />
 </LinearLayout>
</ScrollView>
