<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/screen_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="34sp" android:textStyle="bold"
            android:textColor="@color/text_primary" android:accessibilityHeading="true" />
        <TextView android:id="@+id/home_welcome" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:textSize="18sp" android:textColor="@color/text_secondary" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="@string/games_heading"
            android:textSize="24sp" android:textStyle="bold" android:accessibilityHeading="true" />
        <LinearLayout android:id="@+id/game_catalog" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="@string/more_games_soon"
            android:textColor="@color/text_secondary" />
        <Button android:id="@+id/open_profile" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="28dp" android:minHeight="56dp"
            android:text="@string/profile_title" android:textAllCaps="false" />
        <Button android:id="@+id/open_settings" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="56dp"
            android:text="@string/settings_title" android:textAllCaps="false" />
        <Button android:id="@+id/open_friends" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="56dp"
            android:text="@string/friends_title" android:textAllCaps="false" />
        <Button android:id="@+id/open_guide" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="56dp"
            android:text="@string/guide_title" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
