<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp"
    android:gravity="center_horizontal" android:background="@color/screen_background">
    <TextView android:id="@+id/call_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold"
        android:gravity="center" android:accessibilityLiveRegion="polite" />
    <TextView android:id="@+id/call_timer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="20sp" android:gravity="center"
        android:layout_marginTop="8dp" />
    <LinearLayout android:id="@+id/call_participants" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"
        android:layout_marginTop="20dp" />
    <Button android:id="@+id/call_toggle_mic" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="64dp"
        android:text="@string/mute_microphone" android:textAllCaps="false" />
    <Button android:id="@+id/call_toggle_speaker" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="56dp"
        android:text="@string/use_speaker" android:textAllCaps="false" />
    <Button android:id="@+id/call_raise_hand" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="56dp"
        android:text="@string/raise_hand" android:textAllCaps="false" android:visibility="gone" />
    <Button android:id="@+id/call_leave" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="64dp"
        android:text="@string/leave_call" android:textAllCaps="false" />
</LinearLayout>
