<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/screen_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
  <TextView android:id="@+id/ludo_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:textSize="20sp" android:textStyle="bold" />
  <LinearLayout android:id="@+id/ludo_online_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
   <TextView android:id="@+id/ludo_room_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" />
   <Button android:id="@+id/ludo_share_room" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/share_room" />
   <Button android:id="@+id/ludo_start_with_bots" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ludo_start_with_bots" android:visibility="gone" />
  </LinearLayout>
  <ir.codelighthouse.bazikhooneh.LudoBoardView android:id="@+id/ludo_board" android:layout_width="match_parent" android:layout_height="360dp" android:importantForAccessibility="no" />
  <Button android:id="@+id/ludo_roll" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ludo_roll_dice" />
  <LinearLayout android:id="@+id/ludo_piece_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
  <LinearLayout android:id="@+id/ludo_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" />
 </LinearLayout>
</ScrollView>
