<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:background="@color/screen_background">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sessions_description" android:textSize="18sp" />
 <TextView android:id="@+id/sessions_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:minHeight="48dp" android:accessibilityLiveRegion="polite" />
 <ProgressBar android:id="@+id/sessions_loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" />
 <LinearLayout android:id="@+id/sessions_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
 <Button android:id="@+id/sessions_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/retry" android:visibility="gone" />
 <Button android:id="@+id/revoke_sessions" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/revoke_other_sessions" android:textAllCaps="false" />
</LinearLayout>
