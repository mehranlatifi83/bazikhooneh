<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp"
    android:background="@color/screen_background">
    <TextView android:id="@+id/community_room_header" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold"
        android:accessibilityHeading="true" />
    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:columnCount="2" android:padding="4dp"
        android:background="@color/surface">
            <Button android:id="@+id/community_share" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_columnWeight="1"
                android:text="@string/share_room" android:textAllCaps="false" />
            <Button android:id="@+id/community_copy" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_columnWeight="1"
                android:text="@string/copy_room_code" android:textAllCaps="false" />
            <Button android:id="@+id/community_invite" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_columnWeight="1"
                android:text="@string/invite_friend_to_room" android:textAllCaps="false" />
            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_columnWeight="1">
                <Button android:id="@+id/community_start_call" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/start_voice_call"
                    android:textAllCaps="false" />
                <Button android:id="@+id/community_join_call" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/join_voice_call"
                    android:textAllCaps="false" />
            </FrameLayout>
            <Button android:id="@+id/community_start_tic" android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content" android:text="@string/start_tic_in_room"
                android:textAllCaps="false" />
            <Button android:id="@+id/community_start_ludo" android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content" android:text="@string/start_ludo_in_room"
                android:textAllCaps="false" />
            <Button android:id="@+id/community_history" android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content" android:text="@string/room_history"
                android:textAllCaps="false" />
            <Button android:id="@+id/community_settings" android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content" android:text="@string/room_settings"
                android:textAllCaps="false" />
            <Button android:id="@+id/community_leave" android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content" android:text="@string/leave_room"
                android:textAllCaps="false" />
    </GridLayout>
    <LinearLayout android:id="@+id/community_active_game_panel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"
        android:paddingTop="8dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/community_active_game_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="17sp" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/community_join_game" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:text="@string/join_active_game" android:textAllCaps="false" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/community_members"
        android:textStyle="bold" android:accessibilityHeading="true" />
    <LinearLayout android:id="@+id/community_members_list" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/community_chat"
        android:textStyle="bold" android:accessibilityHeading="true" />
    <ScrollView android:id="@+id/community_chat_scroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/community_messages_list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
    <TextView android:id="@+id/community_room_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="32dp"
        android:accessibilityLiveRegion="polite" />
    <LinearLayout android:id="@+id/community_message_composer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="bottom">
        <EditText android:id="@+id/community_message_input" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:hint="@string/community_message_hint" android:maxLength="2000"
            android:minLines="1" android:maxLines="4" android:gravity="top|start"
            android:inputType="textCapSentences|textMultiLine"
            android:imeOptions="actionSend" />
        <Button android:id="@+id/community_send" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minWidth="72dp"
            android:text="@string/send" android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
